# Discord Bot Token — get from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Google Gemini API Key — get from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# FFLogs V2 API — create a client at https://www.fflogs.com/api/clients
FFLOGS_CLIENT_ID=your_fflogs_client_id
FFLOGS_CLIENT_SECRET=your_fflogs_client_secret

# Channel IDs — right-click a channel in Discord (with Developer Mode on) to copy its ID
INPUT_CHANNEL_ID=0 # Channel where FFLogs links will be posted
OUTPUT_CHANNEL_ID=0 # Channel where Gemini's output will be posted
